      "rampUp": {
        "totalVU": 3,
        "rampupvu": 1,
        "rampduration": 1,
        "holdrampup": 1,
        "duration": 3
      },
      "api": [
        {
          "name": "MCP execute_query tool",
          "method": "POST",
          "url": "${BASE_URL}/mcp",
          "headers": {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream"
          },
          "body": {
            "jsonrpc": "2.0",
            "method": "tools/call",
            "params": {
              "name": "execute_query",
              "arguments": {
                "org_id": "default",
                "stream_name": "default",
                "query": "SELECT * FROM default LIMIT 10"
              }
            },
            "id": "perf-test-execute-query"
          },
          "expectedResponseCode": 200
        }
