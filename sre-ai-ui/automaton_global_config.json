{
  "project_name": "sre-ai-ui",
  "slack": "gen-ai-ci-cd-alerts",
  "email": ["dl-intl-sre-platform@walmart.com"],
  "variables": {
    "scmurl": "https://gecgithub01.walmart.com/intl-ecomm-svcs/sre-ai-ui.git",
