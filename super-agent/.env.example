# ── Agent Identity ────────────────────────────────────────────────────────────
# Used as the ADK app_name and Redis session key prefix.
# Default: health_agent
# APP_NAME=health_agent

# ── Walmart Element Gateway (Azure OpenAI-compatible) ─────────────────────────
ELEMENT_GATEWAY_BASE_URL=https://wmtllmgateway.prod.walmart.com/wmtllmgateway/openai
ELEMENT_GATEWAY_API_KEY=<your-jwt-token>
OPENAI_MODEL=gpt-4.1

# ── Claude LLM (Anthropic Messages API via Walmart Stage Gateway) ─────────────
# Set CLAUDE_IS_PRIMARY_LLM=true to use Claude instead of OpenAI.
CLAUDE_GATEWAY_URL=https://wmtllmgateway.stage.walmart.com/wmtllmgateway/v1/messages
CLAUDE_API_KEY=<your-jwt-token>
CLAUDE_IS_PRIMARY_LLM=false
# CLAUDE_MODEL=claude-opus-4-6
# CLAUDE_ANTHROPIC_VERSION=vertex-2023-10-16

# ── Prompt Caching (Anthropic only — requires CLAUDE_IS_PRIMARY_LLM=true) ────
# Caches system prompt + last user message to reduce latency and token costs.
# LLM_PROMPT_CACHE_ENABLED=false
# LLM_PROMPT_CACHE_EXTENDED=false    # true → ~1 hour TTL; false → ~5 min TTL

# ── Redis (Walmart managed Redis Cluster) ─────────────────────────────────────
REDIS_HOST=<your-redis-host>
REDIS_PASSWORD=<your-redis-password>

# ── Redis connection tuning (optional — defaults shown) ───────────────────────
# Raise REDIS_SOCKET_TIMEOUT if you see "Timeout reading from <host>" in logs.
# REDIS_SOCKET_TIMEOUT=15
# REDIS_SOCKET_CONNECT_TIMEOUT=10
# Set REDIS_MAX_CONNECTIONS = total_cluster_connections / pod_count (e.g. 3000/60=50)
# REDIS_MAX_CONNECTIONS=50

# ── MCP Server Discovery ─────────────────────────────────────────────────────
# Redis key is computed: super_agent:config:mcp_servers:<AGENT_ENV>:<AGENT_GROUP>:config
AGENT_ENV=stage
AGENT_GROUP=sre

# ── SSO credentials (PingFederate headless login) ─────────────────────────────
# Used to obtain a shared bearer token stored in Redis (key: agent:{auth:<app>}:token).
# One pod acquires the token; all 200 pods reuse it — zero extra logins.
# UPN suffix (@homeoffice.wal-mart.com) is appended automatically if missing.
SSO_USERNAME=
SSO_PASSWORD=

# ── PingFed target URLs ──────────────────────────────────────────────────────
# Comma-separated list of OpenObserve cluster URLs to pre-warm at startup.
# When set, supersedes PINGFED_BASE_URL — each cluster gets its own Redis token key.
# PINGFED_BASE_URL=https://intl.logs.prod.walmart.com
# PINGFED_URLS=https://intl.logs.prod.walmart.com,https://gtp.logs.prod.walmart.com

# ── Auth token TTL tuning (optional — defaults shown) ─────────────────────────
# AUTH_TOKEN_TTL=3300           # 55 min — hard Redis key expiry; forces re-login
# AUTH_TOKEN_REFRESH_AT=2700   # 45 min — soft threshold; triggers background refresh
# AUTH_LOCK_TTL=60              # 60 s  — distributed lock expiry (crash-safe)

# ── Agent behaviour ──────────────────────────────────────────────────────────
# MAX_TOOL_ROUNDS=8             # Max LLM ↔ tool call round-trips per query
# LLM_TIMEOUT_SECONDS=60        # Per-LLM-call timeout
# MCP_TIMEOUT_SECONDS=30        # Per-MCP-tool-call timeout
# LLM_HISTORY_TURNS=0           # Number of past turns included in context (0 = all)

# Max characters kept per tool-result block when shrinking context after
# a ContextWindowExceededError. Lower = more aggressive truncation. Default: 1500
# SHRINK_TOOL_RESULT_MAX_CHARS=1500

# ── Skills (ADK SkillToolset) ────────────────────────────────────────────────
# Directory containing skill folders. Set to "" to disable SkillToolset.
# SKILLS_DIR=skills

# Comma-separated list of skill folder names to skip during startup.
# EXCLUDE_SKILLS=cassandra-triage,cosmos-triage

# When true (default), MCP tools are available globally — the agent can call
# any MCP tool directly without loading a skill first.
# When false, MCP tools are ONLY accessible through skills (gated by
# adk_additional_tools in SKILL.md).  Use false for strict skill-based routing.
# ENABLE_MCPS=true

# ── A2A Remote Subagents ─────────────────────────────────────────────────────
# In prod/stage: loaded from Redis. In local dev: point at a YAML file.
# A2A_AGENTS_FILE=/path/to/a2a_agents.yml

# ── Agent Instruction (system prompt) source ─────────────────────────────────
# false (default): load from resources/AGENT_INSTRUCTION.md on disk.
# true:            load from Redis key at startup (hot-reloadable without redeploy).
#   Redis key: super_agent:config:agent_instruction:<AGENT_ENV>:<AGENT_GROUP>:config
# Falls back to the on-disk file on any Redis error.
# AGENT_INSTRUCTION_FROM_REDIS=false

# ── A2UI (Agent-to-UI) ──────────────────────────────────────────────────────
# A2UI_ENABLED=false

# ── Local dev overrides ──────────────────────────────────────────────────────
# Set AGENT_ENV=local to skip Redis and load MCP servers from a local YAML file.
# All other AGENT_ENV values (dev, stage, prod) use Redis.
# AGENT_ENV=local
# MCP_SERVERS_FILE=/path/to/mcp_servers.yml
