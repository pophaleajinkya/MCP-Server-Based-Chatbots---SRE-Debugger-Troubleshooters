# Valid8 MCP Server — Environment Variables
# Copy this file to .env and fill in your values.

# ── Valid8 connection ──────────────────────────────────────────────────────────
# Valid8 base URL (default: https://intl-valid8-qa.walmart.com)
VALID8_BASE_URL=https://intl-valid8-qa.walmart.com

# API key for X-API-Key header (required)
VALID8_API_KEY=your-api-key-here

# HTTP timeout in seconds (default: 60)
VALID8_TIMEOUT=60

# TLS verification for Valid8 calls.
#   true / false   toggle verification on/off
#   <path>         verify using a PEM CA bundle at this path (recommended for
#                  internal Walmart endpoints — point to the corporate bundle)
# Examples:
#   VALID8_VERIFY_SSL=true
#   VALID8_VERIFY_SSL=false
#   VALID8_VERIFY_SSL=/secrets/walmart-ca.pem         # stage/prod (injected by Akeyless, see kitt.yml)
#   VALID8_VERIFY_SSL=./certs/walmart-ca.pem          # local dev (cert kept in git-ignored certs/)
VALID8_VERIFY_SSL=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
VALID8_LOG_LEVEL=INFO

# ── HTTP server (uvicorn / app.py) ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8015
APP_WORKERS=2

# ── HTTP transport (streamable_http) ──────────────────────────────────────────
# Set to 1 when running as a stateless HTTP server (not stdio).
FASTMCP_STATELESS_HTTP=1
