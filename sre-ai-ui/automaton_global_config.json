  },
  "flows": {
    "perf-test": {
      "appurl": "https://sre.ai.dev.walmart.com",
      "duration": "5",
      "vu": "10",
      "dc_load_distribution": {
        "eus2-dev-aperf1": 100
      },
      "config": "/perf/perf.json"
    },
    "perf-test-stage": {
      "appurl": "https://sre.ai.stage.walmart.com",
      "duration": "10",
      "vu": "25",
      "dc_load_distribution": {
        "eus2-dev-aperf1": 50,
        "scus-dev-aperf1": 50
      },
      "config": "/perf/perf.json"
    },
    "perf-test-prod": {
      "appurl": "https://sre.ai.walmart.com",
      "duration": "15",
      "vu": "50",
      "dc_load_distribution": {
        "eus2-perf-a1": 50,
        "wus-perf-a1": 50
      },
      "config": "/perf/perf.json"
    }
  }
}
