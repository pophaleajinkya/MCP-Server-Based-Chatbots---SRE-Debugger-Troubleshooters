{
  "openapi": "3.0.3",
  "info": {
    "title": "Signal MCP Server",
    "version": "1.0.0",
    "description": "MCP server for Walmart International Signal — app inventory, metadata filters, and OE reports"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Server info",
        "operationId": "root",
        "responses": {
          "200": {
            "description": "Server info with tool/resource/prompt counts"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check (startup probe)",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/health/liveness": {
      "get": {
        "summary": "Liveness probe",
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/health/readiness": {
      "get": {
        "summary": "Readiness probe",
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready — cache not yet populated"
          }
        }
      }
    },
    "/mcp/tools": {
      "get": {
        "summary": "List all MCP tools",
        "operationId": "list_tools",
        "responses": {
          "200": {
            "description": "Tool list"
          }
        }
      }
    },
    "/mcp/resources": {
      "get": {
        "summary": "List all MCP resources",
        "operationId": "list_resources",
        "responses": {
          "200": {
            "description": "Resource list"
          }
        }
      }
    },
    "/mcp/prompts": {
      "get": {
        "summary": "List all MCP prompts",
        "operationId": "list_prompts",
        "responses": {
          "200": {
            "description": "Prompt list"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP protocol endpoint (streamable HTTP)",
        "operationId": "mcp_endpoint",
        "responses": {
          "200": {
            "description": "MCP protocol response"
          }
        }
      }
    }
  }
}
