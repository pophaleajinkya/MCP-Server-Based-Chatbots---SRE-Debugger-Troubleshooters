# OpenObserve MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# All vars are prefixed with O2_
#
# NOTE: o2_mcp is stateless. Every tool call receives endpoint + bearer_token
# as parameters from the super-agent. O2_ENDPOINT and O2_AUTH_TOKEN below are
# optional fallbacks for dev/static environments only.

# ── Optional fallbacks (dev/static environments) ──────────────────────────────
# OpenObserve API base URL — only used when endpoint is not passed per-call
O2_ENDPOINT=

# Base64-encoded "root:password" for Basic auth — only used when bearer_token
# is not passed per-call. Generate with:
#   python -c "import base64; print(base64.b64encode(b'root:<token>').decode())"
O2_AUTH_TOKEN=

# Organization ID (default is usually fine)
O2_ORG_ID=default

# ── Optional ──────────────────────────────────────────────────────────────────
# HTTP timeout in seconds (default: 60)
O2_TIMEOUT=60

# Verify TLS certificates — set to true in production (default: false for internal clusters)
O2_SSL_VERIFY=false

# Max rows per query result (default: 10000)
O2_MAX_LIMIT=10000

# Default rows per query (default: 1000)
O2_DEFAULT_LIMIT=1000

# Default time range for queries (default: 1h)
O2_DEFAULT_TIME_RANGE=1h

# Schema field pruning threshold — fields above this count get pruned (default: 30)
O2_SCHEMA_FIELD_THRESHOLD=30

# Enable live SQL validation against cluster (default: true)
O2_ENABLE_SQL_VALIDATION=true

# Enable live VRL validation against cluster (default: true)
O2_ENABLE_VRL_VALIDATION=true

# Use sqlglot AST for SQL policy checks (default: true, falls back to regex if sqlglot not installed)
O2_ENABLE_SQL_AST=true

# Custom path to rules.json (default: data/rules.json relative to project root)
# O2_RULES_PATH=/path/to/custom/rules.json

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
O2_LOG_LEVEL=INFO

# ── HTTP server (uvicorn / app.py) ────────────────────────────────────────────
# Bind address (default: 0.0.0.0)
APP_HOST=0.0.0.0

# Port (default: 8010)
APP_PORT=8010

# Uvicorn worker count (default: 2)
APP_WORKERS=2

# ── HTTP transport (streamable_http) ──────────────────────────────────────────
# Set to 1 when running as a stateless HTTP server (not stdio).
# This tells fastmcp not to maintain session state between requests.
FASTMCP_STATELESS_HTTP=1
