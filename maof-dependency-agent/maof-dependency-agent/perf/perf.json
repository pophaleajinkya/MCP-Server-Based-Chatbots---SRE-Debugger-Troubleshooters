      "transactionName": "HealthCheck",
      "description": "Health endpoint load test - lightweight baseline",
      "rampUp": {
        "totalVU": 10,
        "rampupvu": 5,
        "rampduration": 1,
        "holdrampup": 1,
        "duration": 5
      },
      "api": [
        {
          "name": "Health Check",
          "method": "GET",
          "url": "${BASE_URL}/health",
          "headers": {
            "Content-Type": "application/json",
            "Accept": "*/*"
          },
          "expectedResponseCode": 200
        }
      ]
    },
