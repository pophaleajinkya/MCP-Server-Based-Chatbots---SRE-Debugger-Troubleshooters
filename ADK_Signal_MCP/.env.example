# Signal MCP Server — Environment Variables
# Copy this file to .env and fill in your values.

# ── Signal connection ─────────────────────────────────────────────────────────
# Signal API base URL (default: https://signal-api.walmart.com)
SIGNAL_BASE_URL=https://signal-api.walmart.com

# HTTP timeout in seconds (default: 60)
SIGNAL_TIMEOUT=60

# Verify TLS certificates — set to false for internal/corporate certs
SIGNAL_VERIFY_SSL=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
SIGNAL_LOG_LEVEL=INFO

# ── HTTP server (uvicorn / app.py) ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8020
APP_WORKERS=2

# ── HTTP transport (streamable_http) ──────────────────────────────────────────
# Set to 1 when running as a stateless HTTP server (not stdio).
FASTMCP_STATELESS_HTTP=1
