# ── Server ─────────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT={{cookiecutter.agent_port}}
AGENT_ENV=local

# ── LLM Gateway (Claude via Walmart Stage Gateway) ─────────────────────────
CLAUDE_GATEWAY_URL=https://wmtllmgateway.stage.walmart.com/wmtllmgateway/v1/messages
CLAUDE_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_ANTHROPIC_VERSION=vertex-2023-10-16
CLAUDE_IS_PRIMARY_LLM=true

# ── Redis session storage ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_SSL=false

# ── MCP servers (optional — if your agent uses MCP tools) ──────────────────
# AGENT_ENV=local
# MCP_SERVERS_FILE=./mcp_servers.yml
